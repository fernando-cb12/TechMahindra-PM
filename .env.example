# Database Configuration
POSTGRES_DB=collabx
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret

# Spring Datasource Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/collabx
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=secret

# Spring JPA and Flyway Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# JWT Configuration
JWT_SECRET=please-change-me-use-at-least-32-bytes-for-hs256-in-production
JWT_EXPIRATION_MS=86400000

# CORS Configuration
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# AWS S3 Upload Configuration
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: use a CDN/custom domain instead of the default S3 object URL
AWS_S3_PUBLIC_BASE_URL=
# Optional: upload URL lifetime in seconds
AWS_S3_PRESIGNED_URL_EXPIRATION_SECONDS=300
